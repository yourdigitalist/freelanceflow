{
  "name": "PersonalPreference",
  "type": "object",
  "properties": {
    "date_format": {
      "type": "string",
      "enum": [
        "DD-MM-YYYY",
        "MM-DD-YYYY",
        "YYYY-MM-DD"
      ],
      "default": "DD-MM-YYYY",
      "description": "Preferred date display format"
    },
    "time_format": {
      "type": "string",
      "enum": [
        "12h",
        "24h"
      ],
      "default": "24h",
      "description": "Preferred time format"
    },
    "number_format": {
      "type": "string",
      "enum": [
        "1,000.00",
        "1.000,00",
        "1 000,00"
      ],
      "default": "1,000.00",
      "description": "Preferred number display format"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}