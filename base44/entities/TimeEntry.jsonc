{
  "name": "TimeEntry",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Reference to project"
    },
    "task_id": {
      "type": "string",
      "description": "Optional reference to task"
    },
    "team_id": {
      "type": "string",
      "description": "Reference to team for multi-user support"
    },
    "description": {
      "type": "string",
      "description": "What was worked on"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "hours": {
      "type": "number",
      "description": "Hours worked"
    },
    "billable": {
      "type": "boolean",
      "default": true
    },
    "billed": {
      "type": "boolean",
      "default": false,
      "description": "Whether this time has been invoiced"
    },
    "invoice_id": {
      "type": "string",
      "description": "Reference to invoice if billed"
    }
  },
  "required": [
    "project_id",
    "date",
    "hours"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}